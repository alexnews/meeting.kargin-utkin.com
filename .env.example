# --- database ---
DATABASE_URL=postgresql://meetinglens:meetinglens@localhost:5433/meetinglens

# --- storage ---
STORAGE_DIR=./storage

# --- llm / vlm (local by default; nothing leaves the machine) ---
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:14b
VLM_MODEL=qwen2.5vl:7b
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_HOST=http://localhost:11434

# failover order, comma separated. leave as ollama only for local-first.
LLM_FAILOVER=ollama

# only needed if you deliberately switch off local
# ANTHROPIC_API_KEY=
# NVIDIA_NIM_API_KEY=

# --- asr ---
WHISPER_BIN=./bin/whisper-cli
WHISPER_MODEL=./models/ggml-large-v3-turbo.bin
# whisper.cpp word timestamps are unreliable; whisperx does forced alignment
ASR_BACKEND=whisperx

# --- keyframes ---
KEYFRAME_FPS=1
KEYFRAME_DHASH_THRESHOLD=8
KEYFRAME_STABILITY_MS=2000
KEYFRAME_WEBP_QUALITY=80

# --- worker ---
WORKER_POLL_INTERVAL_S=2
WORKER_MAX_ATTEMPTS=3
