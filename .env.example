# MeetingLens needs no configuration. Every setting below has a working default.
# Copy this file only if you want to override one. Values shown are the defaults.

# Where the database and keyframe images live.
# MEETINGLENS_HOME=~/.meetinglens

# Where exported markdown is written.
# MEETINGLENS_OUTPUT_DIR=~/Documents/MeetingLens

# Your name exactly as Teams writes it in the transcript, used to mark which
# lines are yours. Leave unset if you do not care.
# MEETINGLENS_SELF_NAME=

# --- keyframe detection. Expect to tune these against your own recordings. ---
# MEETINGLENS_KEYFRAME_FPS=1
# MEETINGLENS_DHASH_THRESHOLD=8
# MEETINGLENS_STABILITY_MS=2000
# MEETINGLENS_WEBP_QUALITY=80

# Keyframes whose OCR yields fewer characters than this are dropped. This is
# what removes gallery view, the idle desktop and video playback.
# MEETINGLENS_OCR_MIN_CHARS=20
